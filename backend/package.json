{
  "name": "ziiip-ecommerce-server",
  "version": "1.0.0",
  "description": "ZIIIP E-commerce Backend API with AI-Powered Recommendations",
  "main": "server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "node scripts/seedData.js",
    "generate-embeddings": "node scripts/generateEmbeddings.js",
    "test-recommendations": "node scripts/testRecommendations.js",
    "health-check": "curl http://localhost:5000/api/health"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^6.5.0",
    "sharp": "^0.32.5",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "ecommerce",
    "api",
    "nodejs",
    "express",
    "mongodb",
    "ai",
    "machine-learning",
    "tensorflow",
    "recommendations",
    "cnn",
    "cosine-similarity",
    "nepal"
  ],
  "author": "ZIIIP",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ziiip/ecommerce-server.git"
  },
  "bugs": {
    "url": "https://github.com/ziiip/ecommerce-server/issues"
  },
  "homepage": "https://github.com/ziiip/ecommerce-server#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["**/*.{js,jsx}", "!**/node_modules/**", "!**/coverage/**"]
  }
}
